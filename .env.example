# Environment Configuration for SIH26083 Extreme Heatwave Risk Engine

# App Settings
APP_NAME="SIH26083 Extreme Heatwave Early Warning System"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Operational / Demo Mode
# Set DEMO_MODE=true for guaranteed offline reproducibility with pre-packaged scenarios
DEMO_MODE=false

# Cache Configuration (in seconds)
WEATHER_CACHE_TTL=3600
HISTORICAL_CACHE_TTL=86400

# Geographic Defaults
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
DEFAULT_LOCATION_NAME="Delhi NCR, India"

# Tier-1 External Endpoints
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/daily/point"
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
